# Copy to .env (gitignored).

# --- Databricks (candidate execution, hosted-Claude provider, MLflow auth) ---
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# Candidate backend: local | databricks | databricks_sql
CANDIDATE_BACKEND=databricks_sql
# When CANDIDATE_BACKEND=databricks_sql / databricks, set the target:
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CLUSTER_ID=

# Conversion provider: rule | anthropic | databricks
CONVERTER_PROVIDER=rule
# Only for provider=anthropic:
ANTHROPIC_API_KEY=
# Only for provider=databricks (workspace-hosted Claude):
DATABRICKS_LLM_ENDPOINT=databricks-claude-opus-4-8

# --- Observability ---
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT=

# --- PR creation (gh CLI) ---
GITHUB_REPO=your-username/code-migration-tool
PR_BASE_BRANCH=main
